  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CWatch.Core\CWatch.Core.csproj" />
    <ProjectReference Include="..\CWatch.Storage\CWatch.Storage.csproj" />
    <ProjectReference Include="..\CWatch.Analysis\CWatch.Analysis.csproj" />
    <ProjectReference Include="..\CWatch.Cleanup\CWatch.Cleanup.csproj" />
    <ProjectReference Include="..\CWatch.Monitoring\CWatch.Monitoring.csproj" />
    <ProjectReference Include="..\CWatch.Infrastructure\CWatch.Infrastructure.csproj" />
  </ItemGroup>

</Project>
