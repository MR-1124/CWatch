<UserControl x:Class="CWatch.UI.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="980">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Duplicate Files Analyzer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Display, Aptos Display, Segoe UI, sans-serif"/>
                <TextBlock Text="Multi-phase SHA-256 byte hash detection to safely identify identical redundant files" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍 SCAN DUPLICATES" Command="{Binding StartScanCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Padding="14,7" FontSize="11"/>
                <Button Content="🗑 DELETE SELECTED" Command="{Binding DeleteSelectedDuplicatesCommand}" Style="{StaticResource DangerButton}" Padding="14,7" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- Metrics & Smart Selection Banner -->
        <Border Grid.Row="1" Style="{StaticResource HeroCardBorder}" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status & Reclaimable Metric -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="RECLAIMABLE DUPLICATE SPACE: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedWastedBytes}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <!-- Right: Smart Selection Presets -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="KEEP NEWEST" Command="{Binding KeepNewestCopiesCommand}" Style="{StaticResource ChipButton}" Margin="0,0,6,0" ToolTip="Keeps the most recent copy in each group"/>
                    <Button Content="KEEP OLDEST" Command="{Binding KeepOldestCopiesCommand}" Style="{StaticResource ChipButton}" Margin="0,0,6,0" ToolTip="Keeps the oldest original file"/>
                    <Button Content="SELECT ALL" Command="{Binding SelectAllDuplicatesCommand}" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                    <Button Content="DESELECT ALL" Command="{Binding DeselectAllDuplicatesCommand}" Style="{StaticResource ChipButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Duplicate Groups List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <!-- Group Header -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentOrange}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} IDENTICAL COPIES'}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="FILE WEIGHT: " Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedSize, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- File Entries in Group -->
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardSecondary}" CornerRadius="4" Padding="10,8" Margin="0,0,0,4" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Select Checkbox -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForDeletion}" Margin="0,0,10,0" ToolTip="Select for deletion"/>

                                                    <!-- File Path -->
                                                    <TextBlock Grid.Column="1" Text="{Binding FullPath}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11.5" FontFamily="Consolas, Segoe UI"/>

                                                    <!-- Last Modified -->
                                                    <TextBlock Grid.Column="2" Text="{Binding LastModifiedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="12,0" VerticalAlignment="Center"/>

                                                    <!-- Open Location Button -->
                                                    <Button Grid.Column="3" Content="📂 OPEN" Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource AccentOrange}" BorderThickness="0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Padding="4,2"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
