<UserControl x:Class="CWatch.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,32">
            <!-- Header Title Row -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="System Volume Telemetry" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBlock Text="Continuous storage intelligence, differential growth tracking &amp; safe recovery" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource SecondaryButton}" Content="📈 Inspect Timeline" Command="{Binding InvestigateGrowthCommand}" Margin="0,0,8,0" Padding="12,6" FontSize="11"/>
                    <Button Style="{DynamicResource SuccessButton}" Content="⚡ Safe Cleanup" Command="{Binding RecommendedCleanupCommand}" Padding="14,6" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Emergency Warning Banner -->
            <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding HasEmergencyAlert, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="6" Background="{DynamicResource AccentRed}" CornerRadius="2" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CRITICAL CAPACITY ALERT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentRed}"/>
                        <TextBlock Text="{Binding EmergencyMessage}" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Drive Status Hero Card -->
            <Border Style="{DynamicResource HeroCardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drive Info & Big Metrics -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Drive Identity & Trend -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccentOrange}" CornerRadius="3" Width="24" Height="24" Margin="0,0,10,0">
                                    <TextBlock Text="C:" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="LOCAL DISK (C:)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DriveStatus.FileSystem, StringFormat={}{0} FILE SYSTEM}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <!-- Trend Indicator Badge -->
                            <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource AccentAmber}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrendMessage}" FontSize="11" Foreground="{DynamicResource AccentAmber}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Free & Used numbers -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right">
                                <Run Text="{Binding DriveStatus.FreeBytes, Mode=OneWay, Converter={StaticResource SizeFormatter}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                <Run Text=" FREE" FontSize="12" Foreground="{DynamicResource TextMuted}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0">
                                <Run Text="{Binding DriveStatus.UsedBytes, Mode=OneWay, Converter={StaticResource SizeFormatter}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <Run Text=" ALLOCATED OF " Foreground="{DynamicResource TextMuted}"/>
                                <Run Text="{Binding DriveStatus.TotalBytes, Mode=OneWay, Converter={StaticResource SizeFormatter}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Usage Solid Signal Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgInput}" Height="12" CornerRadius="3" Margin="0,16,0,8" ClipToBounds="True" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <Grid>
                            <ProgressBar Value="{Binding DriveStatus.UsedPercentage, Mode=OneWay}" Maximum="100" Height="12" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentOrange}"/>
                        </Grid>
                    </Border>

                    <!-- Footer Telemetry Strip -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DriveStatus.UsedPercentage, StringFormat='{}{0:F1}% Capacity Consumed'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text=" • " Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding DriveStatus.FreePercentage, StringFormat='{}{0:F1}% Available Headroom'}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="RECLAIMABLE SAFE SPACE: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding FormattedSafeCleanupPotential}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2-Column Split: Storage Category Matrix & Top Growth Culprit -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Storage Allocation Categories -->
                <Border Grid.Column="0" Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STORAGE CATEGORY ALLOCATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="BY BYTE WEIGHT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Color Indicator Bar -->
                                            <Rectangle Grid.Column="0" Width="4" Height="28" RadiusX="2" RadiusY="2" Fill="{Binding Category, Converter={StaticResource CategoryColorConverter}}" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Culprit Diagnosis & Rapid Growth Alert -->
                <Border Grid.Column="2" Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="PRIMARY EXPANSION CULPRIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                        <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="LARGEST EXPANDING DIRECTORY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding TopCulpritDirectory}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentOrange}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TopCulpritGrowthRate}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="RECOMMENDED ACTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,8"/>
                        <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding RecommendedActionSummary}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="16"/>
                                <Button Content="EXPLORE RECURRING CACHES →" Command="{Binding InvestigateGrowthCommand}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
