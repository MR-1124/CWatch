<UserControl x:Class="CWatch.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,32">

            <!-- Page header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}"
                               Text="{Binding DriveStatus.DriveLetter, StringFormat='Drive {0}'}"/>
                    <TextBlock Text="How space is allocated, what is growing, and what you can safely free."
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource SecondaryButton}" Content="View timeline"
                            Command="{Binding InvestigateGrowthCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Style="{DynamicResource SuccessButton}" Content="Clean up safely"
                            Command="{Binding RecommendedCleanupCommand}" Padding="14,6"/>
                </StackPanel>
            </Grid>

            <!-- Capacity alert -->
            <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource AccentRed}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,0,16"
                    Visibility="{Binding HasEmergencyAlert, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4" Background="{DynamicResource AccentRed}" CornerRadius="2" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Margin="0,2">
                        <TextBlock Text="Running out of space" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource AccentRed}"/>
                        <TextBlock Text="{Binding EmergencyMessage}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ The instrument: capacity at a glance ============ -->
            <Border Style="{DynamicResource HeroCardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Identity + numbers -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccentOrange}" CornerRadius="2"
                                        Width="26" Height="26" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding DriveStatus.DriveLetter}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding DriveStatus.VolumeLabel}" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeSection}"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Chip}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DriveStatus.FileSystem}" FontSize="{StaticResource FontSizeMicro}"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <Border Style="{StaticResource Chip}" Padding="10,4" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentAmber}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrendMessage}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource AccentAmber}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right">
                                <Run Text="{Binding DriveStatus.FreeBytes, Mode=OneWay, Converter={StaticResource SizeFormatter}}"
                                     FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" FontSize="26" FontWeight="SemiBold"
                                     Foreground="{DynamicResource AccentGreen}"/>
                                <Run Text=" free" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0">
                                <Run Text="{Binding DriveStatus.UsedBytes, Mode=OneWay, Converter={StaticResource SizeFormatter}}"
                                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <Run Text=" used of " Foreground="{DynamicResource TextMuted}"/>
                                <Run Text="{Binding DriveStatus.TotalBytes, Mode=OneWay, Converter={StaticResource SizeFormatter}}"
                                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Capacity instrument: bar, ticks, 90% red line -->
                    <Grid Grid.Row="1" Margin="0,18,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <ProgressBar Value="{Binding DriveStatus.UsedPercentage, Mode=OneWay}" Maximum="100"
                                         Foreground="{Binding DriveStatus.UsedPercentage, Converter={StaticResource CapacityPressureColorConverter}}"/>
                            <!-- Red line at 90% -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="1" Width="2" HorizontalAlignment="Left" Margin="-1,0,0,0"
                                           Fill="{DynamicResource AccentRed}" Opacity="0.85"/>
                            </Grid>
                        </Grid>

                        <!-- Scale labels aligned to the bar -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="0" FontSize="{StaticResource FontSizeMicro}" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Grid.Column="2" Text="50" FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="90" FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{DynamicResource AccentRed}" HorizontalAlignment="Right" Margin="0,0,1,0"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="100%" FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Pressure summary -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DriveStatus.UsedPercentage, StringFormat='{}{0:F1}% used'}"
                                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding DriveStatus.FreePercentage, StringFormat='{}{0:F1}% free'}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Cleanup can free " FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding FormattedSafeCleanupPotential}" FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentGreen}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ Where the space goes / what grows ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Allocation: stacked band + rows -->
                <Border Grid.Column="0" Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Where the space goes" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="share of used space" FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Margin="0,0,10,0"
                                                   Fill="{Binding Category, Converter={StaticResource CategoryColorConverter}}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeMicro}"
                                                       Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="{StaticResource FontSizeMicro}"
                                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Growth: the one directory that matters -->
                <Border Grid.Column="2" Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Biggest riser" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TopCulpritDirectory}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{DynamicResource AccentOrange}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TopCulpritDirectory}"/>
                                <TextBlock Text="{Binding TopCulpritGrowthRate}" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Next step" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding RecommendedActionSummary}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="17"/>
                        <Button Content="Find recurring caches" Command="{Binding InvestigateGrowthCommand}"
                                Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Padding="10,5" FontSize="{StaticResource FontSizeMicro}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
