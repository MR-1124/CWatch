<UserControl x:Class="CWatch.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,32">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="How C:Watch scans, monitors, and looks."
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Restore defaults" Command="{Binding ResetDefaultsCommand}"
                            Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="Save changes" Command="{Binding SaveSettingsCommand}"
                            Style="{DynamicResource ModernButton}" Padding="14,6"/>
                </StackPanel>
            </Grid>

            <!-- Pending changes bar: answers "did my edit take?" -->
            <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource AccentAmber}"
                    BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentAmber}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Unsaved changes" FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — save to apply them to the running app" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Discard" Command="{Binding DiscardChangesCommand}"
                            Style="{DynamicResource GhostButton}" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Save now" Command="{Binding SaveSettingsCommand}"
                            Style="{DynamicResource ModernButton}" Padding="12,4"/>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource AccentGreen}" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

            <!-- Offline guarantee -->
            <Border Style="{DynamicResource HeroCardBorder}" Padding="14" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                               Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="C:Watch runs entirely on this PC. Nothing is sent over the network."
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock Text="Dark, light, or follow Windows."
                                   Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" SelectedValuePath="Tag"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Dark" Tag="Dark"/>
                        <ComboBoxItem Content="Light" Tag="Light"/>
                        <ComboBoxItem Content="Windows" Tag="System"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Target drive -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Drive to watch" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock Text="Scans, snapshots, trends, and cleanup follow this drive."
                                   Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                        <TextBlock Text="Changing the drive takes effect when you save. The dashboard refreshes immediately; new scans use it right away."
                                   Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeMicro}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}"
                              SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Monitoring -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Background monitoring" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Records lightweight snapshots so trends and forecasts work."
                                       Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Settings.MonitoringEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Check interval" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Minutes between drive checks (default 30)."
                                       Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.MonitorIntervalMinutes}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Warn when free space below" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Gigabytes free that trigger a warning (default 25)."
                                       Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.WarningThresholdGb}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Critical when free space below" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Gigabytes free that trigger a critical alert (default 10)."
                                       Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.CriticalThresholdGb}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Scan when the app opens" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock Text="Starts a full scan automatically at launch."
                                   Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.AutoScanOnLaunch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Retention -->
            <Border Style="{DynamicResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Keep snapshots for" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock Text="Days of history before automatic pruning (default 90)."
                                   Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Settings.RetentionDays}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
