<UserControl x:Class="CWatch.UI.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="980">
    <Grid>
        <!-- Main Cleanup Page Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,36">
                <!-- Header Row -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Recommended Safe Cleanup" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Display, Aptos Display, Segoe UI, sans-serif"/>
                        <TextBlock Text="Reclaim disk space with explicit safety classifications, human rationale, and dry-run protection" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄 RESCAN" Command="{Binding ScanCandidatesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,7" FontSize="11"/>
                        <Button Content="✨ CLEAN SELECTED SPACE" Command="{Binding RequestCleanSelectedCommand}" Style="{StaticResource SuccessButton}" Padding="16,7" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Selection & Total Summary Banner -->
                <Border Style="{StaticResource HeroCardBorder}" Margin="0,0,0,18" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="SELECT SAFE ONLY" Command="{Binding SelectAllSafeCommand}" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                            <Button Content="DESELECT ALL" Command="{Binding DeselectAllCommand}" Style="{StaticResource ChipButton}"/>
                        </StackPanel>

                        <!-- Total Space Selected -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SELECTED TO RECLAIM: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FormattedTotalSelected, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                <!-- Cleanup Candidates List -->
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Candidate Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <!-- Title & Safety Badge -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <!-- Safety Badge Pill -->
                                            <Border Background="{Binding SafetyBadgeColor}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SafetyBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Size Pill -->
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Detailed Explanations -->
                                    <Border Grid.Row="1" Background="{StaticResource BgCardSecondary}" CornerRadius="4" Padding="12,10" Margin="28,12,0,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Why is it here? -->
                                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                                <TextBlock Text="WHY IS THIS HERE?" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- What happens if cleaned? -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                                <TextBlock Text="WHAT HAPPENS AFTER CLEANUP?" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding WhatWillHappen}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Path -->
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" FontFamily="Consolas, Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Action Links -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,0,0,0">
                                        <Button Content="📂 OPEN LOCATION" Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource AccentOrange}" BorderThickness="0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Padding="0,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Dry-Run Confirmation Modal Overlay -->
        <Border Background="#E607080A" Visibility="{Binding ShowConfirmationModal, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource HeroCardBorder}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Confirm Storage Cleanup" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Review the selected items before proceeding. This will permanently remove the selected cache files and disposable temporary data." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Summary Card -->
                    <Border Background="{StaticResource BgCardSecondary}" CornerRadius="4" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TOTAL SPACE TO RECLAIM: " Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FormattedTotalSelected, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Progress Indicator when cleaning -->
                    <StackPanel Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                        <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0" Background="{StaticResource BgInput}" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CurrentCleaningProgress}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Modal Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="CANCEL" Command="{Binding CancelConfirmationCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,7" FontSize="11"/>
                        <Button Grid.Column="1" Content="🚀 PROCEED &amp; CLEAN" Command="{Binding ConfirmCleanCommand}" Style="{StaticResource SuccessButton}" Padding="16,7" FontSize="11" IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
