<UserControl x:Class="CWatch.UI.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="980">
    <Grid>
        <!-- Main Cleanup Page Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,32">
                <!-- Header Row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Recommended Safe Cleanup" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                        <TextBlock Text="Reclaim disk space with explicit safety classifications, human rationale, and dry-run protection" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="RESCAN" Command="{Binding ScanCandidatesCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="11"/>
                        <Button Content="⚡ CLEAN SELECTED SPACE" Command="{Binding RequestCleanSelectedCommand}" Style="{DynamicResource SuccessButton}" Padding="14,6" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Post-Cleanup Celebration State Banner -->
                <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasCompletedCleanup, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨ SPACE RECLAIMED SUCCESSFULLY: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                <TextBlock Text="{Binding LastResult.FormattedBytesCleaned}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastResult.FormattedTotalOperations, StringFormat='{}{0} operations completed without errors.'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕ DISMISS" Command="{Binding DismissCelebrationCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="9.5"/>
                    </Grid>
                </Border>

                <!-- Selection & Total Summary Banner with Safety Filter Toolbar -->
                <Border Style="{DynamicResource HeroCardBorder}" Margin="0,0,0,12" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top row: Selection presets & total -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="SELECT SAFE ONLY" Command="{Binding SelectAllSafeCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                                <Button Content="DESELECT ALL" Command="{Binding DeselectAllCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SELECTED TO RECLAIM: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FormattedTotalSelected, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom row: Safety Level Filter Chips -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SAFETY LEVEL: " FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="ALL CANDIDATES" Command="{Binding SetSafetyFilterCommand}" CommandParameter="All" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9" Margin="0,0,4,0"/>
                            <Button Content="100% SAFE ONLY" Command="{Binding SetSafetyFilterCommand}" CommandParameter="SafeOnly" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9" Margin="0,0,4,0"/>
                            <Button Content="CAUTION REQUIRED" Command="{Binding SetSafetyFilterCommand}" CommandParameter="ReviewOnly" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9" Margin="0,0,4,0"/>
                            <Button Content="DEV / BUILD CACHES" Command="{Binding SetSafetyFilterCommand}" CommandParameter="DevOnly" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                <!-- Empty State -->
                <Border Background="Transparent" Visibility="{Binding Candidates.Count, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No cleanup candidates match current filters." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Cleanup Candidates List -->
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Candidate Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <!-- Title & Safety Badge -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <!-- Safety Badge Pill -->
                                            <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SafetyBadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Size Pill -->
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentOrange}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Detailed Explanations -->
                                    <Border Grid.Row="1" Background="{DynamicResource BgCardNested}" CornerRadius="3" Padding="12,8" Margin="28,8,0,8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Path -->
                                            <TextBlock Grid.Row="0" Text="{Binding TargetPath}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" FontFamily="Consolas, Cascadia Code, monospace"/>

                                            <!-- Why safe? -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="RATIONALE: " FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding HumanRationale}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>

                                            <!-- Consequence -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="SIDE EFFECT: " FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding ConsequenceExplanation}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Candidate Action Buttons -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,0,0,0">
                                        <Button Content="OPEN IN EXPLORER" Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="9.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Dry Run & Execution Modal Overlay -->
        <Border Background="#CC05070A" Visibility="{Binding ShowConfirmationModal, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{DynamicResource HeroCardBorder}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Confirm Safe Space Reclaim" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="The following operations will be performed safely according to Windows safety guidelines." Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding FormattedTotalSelected, StringFormat='Total Target Payload: {0}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentGreen}"/>
                            <TextBlock Text="Items selected for safe cleanup." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Modal Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL" Command="{Binding CancelConfirmationCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="14,6" FontSize="11"/>
                        <Button Content="⚡ PROCEED WITH CLEANUP" Command="{Binding ConfirmCleanCommand}" Style="{DynamicResource SuccessButton}" Padding="16,6" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
