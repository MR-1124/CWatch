<UserControl x:Class="CWatch.UI.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="980">
    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Storage Explorer" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                <TextBlock Text="Hierarchical breakdown of directories, package stores, build caches, and system allocations" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Search Filter Box with Clear Button -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Padding="10,6,28,6" ToolTip="Filter items in current directory..."/>
                <Button Content="✕" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextMuted}" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Padding="4" FontSize="10" Visibility="{Binding SearchFilter, Converter={StaticResource StringToVisibility}}"/>
            </Grid>
        </Grid>

        <!-- Category & Sort Filter Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Category Filters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CATEGORY: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="ALL" Command="{Binding SetCategoryFilterCommand}" CommandParameter="All" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                    <Button Content="DEV / BUILD" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Developer" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                    <Button Content="APP DATA" Command="{Binding SetCategoryFilterCommand}" CommandParameter="AppData" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                    <Button Content="SYSTEM" Command="{Binding SetCategoryFilterCommand}" CommandParameter="System" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                    <Button Content="MEDIA" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Media" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5"/>
                </StackPanel>

                <!-- Sorting Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SORT: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <Button Content="SIZE ↓" Command="{Binding SetSortCommand}" CommandParameter="SizeDesc" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                    <Button Content="NAME A-Z" Command="{Binding SetSortCommand}" CommandParameter="NameAsc" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                    <Button Content="ITEMS ↓" Command="{Binding SetSortCommand}" CommandParameter="ItemsDesc" Style="{DynamicResource SecondaryButton}" Padding="6,2" FontSize="9.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Breadcrumb & Path Security Bar -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="8,5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back / Up Button -->
                <Button Grid.Column="0" Command="{Binding NavigateUpCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0" ToolTip="Navigate up to parent directory">
                    <TextBlock Text="▲ UP" FontSize="10" FontWeight="Bold"/>
                </Button>

                <!-- Breadcrumbs -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Name}" Command="{Binding DataContext.NavigateToItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource AccentOrange}" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12" Padding="4,2"/>
                                    <TextBlock Text="/" Foreground="{DynamicResource TextMuted}" Margin="2,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Status / Critical Path Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,8,0" Visibility="{Binding IsCurrentPathCritical, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="SYSTEM CRITICAL" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}"/>
                    </Border>
                    <Border Background="{DynamicResource BgCardNested}" CornerRadius="3" Padding="8,3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <TextBlock Text="{Binding DisplayedItems.Count, StringFormat='{}{0} ITEMS'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Items Table -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorder}" Padding="0">
            <Grid>
                <!-- Empty State Banner -->
                <Border Background="Transparent" Visibility="{Binding DisplayedItems.Count, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No items matching current filters or empty directory." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListView ItemsSource="{Binding DisplayedItems}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderLight}">
                                        <MenuItem Header="Open / Drill Down" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="{DynamicResource TextPrimary}"/>
                                        <MenuItem Header="Open in File Explorer" Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="{DynamicResource TextPrimary}"/>
                                        <MenuItem Header="Copy Full Path" Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="{DynamicResource TextPrimary}"/>
                                        <MenuItem Header="Show File Properties" Command="{Binding DataContext.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="{DynamicResource TextPrimary}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- Name & Type -->
                            <GridViewColumn Header="NAME" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="2" Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IsDirectory, Converter={StaticResource CategoryColorConverter}, ConverterParameter='type'}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentOrange}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Size -->
                            <GridViewColumn Header="ALLOCATED SIZE" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplaySize}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="11.5"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Proportion of Parent Meter -->
                            <GridViewColumn Header="PROPORTION" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="150" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding RelativePercentage, Mode=OneWay}" Maximum="100" Height="6" Background="{DynamicResource BgInput}" Foreground="{DynamicResource AccentOrange}" BorderThickness="0"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Category -->
                            <GridViewColumn Header="CATEGORY" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="2" Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="{Binding Category, Converter={StaticResource CategoryColorConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Sub-Items / Count -->
                            <GridViewColumn Header="ITEMS" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileCount, StringFormat='{}{0:N0} files'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer Statistics Strip -->
        <Border Grid.Row="4" Background="{DynamicResource BgCardNested}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="12,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusInfo}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="HINT: Double-click to drill down, right-click for quick actions." FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
