<Window x:Class="CWatch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CWatch.UI.Views"
        xmlns:vm="clr-namespace:CWatch.UI.ViewModels"
        mc:Ignorable="d"
        Title="C:Watch — Storage intelligence and cleaner" Height="820" Width="1280"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app_icon.png"
        Background="{DynamicResource BgCanvas}">

    <Window.Resources>
        <Style x:Key="SideNav" TargetType="RadioButton" BasedOn="{StaticResource NavButton}">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="NavCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="10,2,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Brand + drive state -->
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="4"
                                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" ClipToBounds="True" Margin="0,0,10,0">
                            <Image Source="Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="C:Watch" FontFamily="{StaticResource FontDisplay}"
                                   FontSize="{StaticResource FontSizeSection}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Style="{StaticResource Chip}" Padding="10,6" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentGreen}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DriveStatus.DriveLetter, StringFormat='{}{0} local drive'}"
                                           FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DriveStatus.FileSystem}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,14">
                    <Border Style="{StaticResource Chip}" Padding="10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                       Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Works fully offline" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeModeTooltip}"
                            Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                            Padding="10,6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ThemeModeLabel}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="&#xE895;" FontFamily="{StaticResource FontIcon}" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Watch" Style="{StaticResource NavCaption}"/>
                        <RadioButton x:Name="NavDashboard" Tag="Dashboard" GroupName="nav" IsChecked="True"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentOrange}"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavExplorer" Tag="Explorer" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Storage explorer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLargestFiles" Tag="LargestFiles" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Largest files" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDuplicates" Tag="Duplicates" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Duplicate files" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="Analyze" Style="{StaticResource NavCaption}" Margin="10,16,0,4"/>
                        <RadioButton x:Name="NavHistory" Tag="History" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Storage timeline" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRecurring" Tag="Recurring" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Recurring growth" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavReports" Tag="Reports" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Diagnostic reports" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="Maintain" Style="{StaticResource NavCaption}" Margin="10,16,0,4"/>
                        <RadioButton x:Name="NavCleanup" Tag="Cleanup" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Safe cleanup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Tag="Settings" GroupName="nav"
                                     Style="{StaticResource SideNav}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource FontIcon}" FontSize="13" Width="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- The one accent-filled button in the shell -->
                        <Button Style="{DynamicResource ModernButton}" Command="{Binding StartScanCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="12,9" HorizontalAlignment="Stretch" Margin="0,18,0,4"
                                Content="Run full scan"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Content column ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Telemetry strip -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DriveStatus.DriveLetter, StringFormat='Drive {0}'}"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DriveStatus.FormattedUsed, StringFormat='{}{0} used'}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="of" Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeCaption}"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding DriveStatus.FormattedTotal}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DriveStatus.FormattedFree, StringFormat=' ({0} free)'}"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Scan progress, shown only while scanning -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="140" Height="6" BorderThickness="0" Margin="0,0,10,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ScanProgress.EstimatedPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding ScanProgress.IsIndeterminate, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentOrange}"/>
                        <TextBlock Text="{Binding ScanProgress.CurrentPhase}" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource AccentOrange}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Command="{Binding CancelScanCommand}" Style="{StaticResource GhostButton}"
                                Padding="8,3" Margin="8,0,0,0" FontSize="{StaticResource FontSizeMicro}" Content="Cancel"/>
                    </StackPanel>

                    <!-- Health state -->
                    <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding DriveStatus.HealthScore, Converter={StaticResource HealthScoreColorConverter}}"/>
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding DriveStatus.HealthScore, Converter={StaticResource HealthScoreColorConverter}}"
                                       Text="{Binding DriveStatus.HealthScore, Converter={StaticResource HealthScoreTextConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- View host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
                        <views:ExplorerView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LargestFilesViewModel}">
                        <views:LargestFilesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
                        <views:DuplicatesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:RecurringViewModel}">
                        <views:RecurringView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
                        <views:CleanupView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
