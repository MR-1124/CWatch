<Window x:Class="CWatch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CWatch.UI.Views"
        xmlns:vm="clr-namespace:CWatch.UI.ViewModels"
        mc:Ignorable="d"
        Title="C:Watch — Storage Intelligence &amp; Cleaner" Height="800" Width="1240"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app_icon.png"
        Background="{StaticResource BgCanvas}">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgCardHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" ClipToBounds="True" Background="{StaticResource BgCard}">
                            <Image Source="Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="C:WATCH" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                            <TextBlock Text="STORAGE INTELLIGENCE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Drive Selector Pill -->
                    <Border Background="{StaticResource BgCardSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Drive C: (Local Disk)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="NTFS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Offline Privacy Footer -->
                <Border DockPanel.Dock="Bottom" Margin="16,10,16,16" Background="{StaticResource BgCardSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="100% OFFLINE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            <TextBlock Text="Zero Telemetry / Local Only" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Links List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0">
                        <!-- Telemetry Group -->
                        <TextBlock Text="TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,6,0,4"/>
                        <Button Style="{StaticResource NavButton}" Content="⊞  Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                        <Button Style="{StaticResource NavButton}" Content="📁  Storage Explorer" Command="{Binding NavigateCommand}" CommandParameter="Explorer"/>
                        <Button Style="{StaticResource NavButton}" Content="📄  Largest Files" Command="{Binding NavigateCommand}" CommandParameter="LargestFiles"/>
                        <Button Style="{StaticResource NavButton}" Content="📑  Duplicate Files" Command="{Binding NavigateCommand}" CommandParameter="Duplicates"/>

                        <!-- Analytics & Trends Group -->
                        <TextBlock Text="INTELLIGENCE &amp; TRENDS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,16,0,4"/>
                        <Button Style="{StaticResource NavButton}" Content="📈  Storage Timeline" Command="{Binding NavigateCommand}" CommandParameter="History"/>
                        <Button Style="{StaticResource NavButton}" Content="🔄  Recurring Growth" Command="{Binding NavigateCommand}" CommandParameter="Recurring"/>
                        <Button Style="{StaticResource NavButton}" Content="📋  Diagnostic Report" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>

                        <!-- Actions & Maintenance Group -->
                        <TextBlock Text="MAINTENANCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="10,16,0,4"/>
                        <Button Style="{StaticResource NavButton}" Content="🧹  Safe Cleanup" Command="{Binding NavigateCommand}" CommandParameter="Cleanup"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙  Preferences" Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Live Telemetry Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drive Status Widget / Scanning Progress -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Normal Drive Status when not scanning -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Background="{StaticResource BgCardSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="C: VOLUME: " Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DriveStatus.FreeBytes, Converter={StaticResource SizeFormatter}}" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text=" FREE OF " Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DriveStatus.TotalBytes, Converter={StaticResource SizeFormatter}}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Live Scanning Indicator -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,10,0" BorderThickness="0" Background="{StaticResource BgCard}" Foreground="{StaticResource AccentOrange}"/>
                            <TextBlock Text="{Binding ScanProgress.CurrentPhase}" FontSize="11" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScanProgress.FilesScanned, StringFormat=' ({0:N0} files scanned)'}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Scan Trigger / Cancel Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⚡ SCAN C: DRIVE" Command="{Binding StartScanCommand}" Style="{StaticResource ModernButton}" Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}" Padding="16,6" FontSize="11"/>
                        <Button Content="✖ CANCEL SCAN" Command="{Binding CancelScanCommand}" Style="{StaticResource DangerButton}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Padding="14,6" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Active View Container -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
                        <views:ExplorerView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LargestFilesViewModel}">
                        <views:LargestFilesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
                        <views:DuplicatesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:RecurringViewModel}">
                        <views:RecurringView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
                        <views:CleanupView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
