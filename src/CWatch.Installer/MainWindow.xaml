<Window x:Class="CWatch.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C:Watch Setup" Height="480" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="Assets/app_icon.png"
        Background="{StaticResource BgCanvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="C:Watch Setup" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource FontDisplay}"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Choose where to install" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="4" Width="44" Height="44" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
                    <Image Source="Assets/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Grid>
        </Border>

        <!-- Step pages -->
        <Grid Grid.Row="1" Margin="32,20">
            <!-- Step 1: location -->
            <StackPanel x:Name="Step1Welcome" Visibility="Visible">
                <TextBlock Text="Choose install location" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Text="Setup installs C:Watch into the folder below. To use a different folder, select Browse and pick another location." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Install folder" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInstallPath" TextChanged="TxtInstallPath_TextChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Browse" Click="BtnBrowse_Click" Style="{StaticResource SecondaryButton}" Padding="14,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgCardSecondary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Space required " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="about 70 MB" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Available " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtSpaceAvailable" Text="Computing..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Step 2: options -->
            <StackPanel x:Name="Step2Options" Visibility="Collapsed">
                <TextBlock Text="Choose setup options" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Text="Pick what Setup should do while installing C:Watch." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,18"/>

                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Shortcuts and startup" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkDesktopShortcut" IsChecked="True" Margin="0,0,0,14">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Create a desktop shortcut" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text="Adds a launch icon to your Windows desktop" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkStartMenuShortcut" IsChecked="True" Margin="0,0,0,14">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Create a Start Menu shortcut" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text="Adds C:Watch to the Start Menu program list" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkAutoStartup" IsChecked="False">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Start C:Watch when Windows starts" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text="Runs minimized and monitors storage in the background" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 3: installing -->
            <StackPanel x:Name="Step3Installing" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Installing C:Watch" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Text="This takes a moment." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,20"/>

                <ProgressBar x:Name="InstallProgressBar" Height="10" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtInstallStatus" Text="Extracting files..." FontSize="11.5" Foreground="{StaticResource TextMuted}" FontFamily="Consolas, Segoe UI"/>
            </StackPanel>

            <!-- Step 4: finished -->
            <StackPanel x:Name="Step4Finished" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentGreen}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="C:Watch is installed" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource FontDisplay}"/>
                        <TextBlock Text="Setup finished. You can open C:Watch now." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="40,10,40,20">
                    <CheckBox x:Name="ChkLaunchApp" IsChecked="True" HorizontalAlignment="Center">
                        <TextBlock Text="Open C:Watch now" FontWeight="SemiBold" FontSize="12.5" Margin="6,0,0,0"/>
                    </CheckBox>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer actions -->
        <Border Grid.Row="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Padding="14,6"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Content="Back" Click="BtnBack_Click" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,6"/>
                    <Button x:Name="BtnNext" Content="Next" Click="BtnNext_Click" Style="{StaticResource PrimaryButton}" Padding="16,6"/>
                    <Button x:Name="BtnFinish" Content="Finish" Click="BtnFinish_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource AccentGreen}" Visibility="Collapsed" Padding="18,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
