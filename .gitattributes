# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly set line endings for specific Windows/PowerShell files
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.xaml text eol=crlf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
*.zip binary
